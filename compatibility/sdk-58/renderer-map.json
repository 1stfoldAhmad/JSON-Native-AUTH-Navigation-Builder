{
  "sdkVersion": 58,
  "renderers": {
    "ios": {
      "defaultMode": "strict-native",
      "engine": "expo-ui-swiftui",
      "hostComponent": "Host",
      "hostImportPath": "@expo/ui/swift-ui",
      "routerIntegration": {
        "factory": "createStandardRouterNavigator",
        "stackRouter": "StackRouter",
        "tabRouter": "TabRouter",
        "libraryBridge": "integrateWithRouter"
      },
      "navigators": {
        "stack": {
          "capabilityId": "navigation.stack",
          "component": "NavigationStack",
          "importPath": "@expo/ui/swift-ui",
          "routerType": "StackRouter",
          "adapterModule": "renderers/ios/NativeStack.ios.tsx",
          "supportsControlledPath": true,
          "supportsInteractiveSwipeBack": true
        },
        "tabs": {
          "capabilityId": "navigation.tabs",
          "component": "TabView",
          "importPath": "@expo/ui/swift-ui",
          "routerType": "TabRouter",
          "adapterModule": "renderers/ios/NativeTabs.ios.tsx",
          "preservesPerTabStackState": true
        },
        "split": {
          "capabilityId": "navigation.split",
          "component": "NavigationSplitView",
          "importPath": "@expo/ui/swift-ui",
          "routerType": "StackRouter",
          "adapterModule": "renderers/ios/NativeSplitView.ios.tsx"
        },
        "drawer": {
          "capabilityId": "navigation.drawer",
          "component": "NavigationSplitView",
          "importPath": "@expo/ui/swift-ui",
          "routerType": "StackRouter",
          "adapterModule": "renderers/ios/NativeSplitView.ios.tsx"
        },
        "modal": {
          "capabilityId": "navigation.modal",
          "component": "BottomSheet",
          "importPath": "@expo/ui/swift-ui",
          "routerType": "StackRouter",
          "adapterModule": "renderers/ios/NativeStack.ios.tsx"
        }
      }
    },
    "android": {
      "defaultMode": "automatic-fallback",
      "engine": "expo-ui-compose-router-hybrid",
      "hostComponent": "Host",
      "hostImportPath": "@expo/ui/jetpack-compose",
      "routerIntegration": {
        "factory": "createStandardRouterNavigator",
        "stackRouter": "StackRouter",
        "tabRouter": "TabRouter",
        "bridge": "expo-router"
      },
      "navigators": {
        "stack": {
          "capabilityId": "navigation.stack",
          "component": "Stack",
          "importPath": "expo-router",
          "uiChromeComponent": "TopAppBar",
          "uiChromeImportPath": "@expo/ui/jetpack-compose",
          "adapterModule": "renderers/android/NativeStack.android.tsx",
          "supportsHardwareBack": true
        },
        "tabs": {
          "capabilityId": "navigation.tabs",
          "component": "NavigationBar",
          "itemComponent": "NavigationBarItem",
          "importPath": "@expo/ui/jetpack-compose",
          "routerComponent": "TabRouter",
          "fallbackComponent": "NativeTabs",
          "fallbackImportPath": "expo-router/native-tabs",
          "adapterModule": "renderers/android/NativeTabs.android.tsx",
          "preservesPerTabStackState": true
        },
        "drawer": {
          "capabilityId": "navigation.drawer",
          "component": "Drawer",
          "importPath": "expo-router/drawer",
          "adapterModule": "renderers/android/NativeDrawer.android.tsx"
        },
        "split": {
          "capabilityId": "navigation.split",
          "component": "Drawer",
          "importPath": "expo-router/drawer",
          "adapterModule": "renderers/android/NativeDrawer.android.tsx"
        },
        "modal": {
          "capabilityId": "navigation.modal",
          "component": "ModalBottomSheet",
          "importPath": "@expo/ui/jetpack-compose",
          "routerComponent": "Stack.Screen",
          "adapterModule": "renderers/android/NativeStack.android.tsx"
        }
      }
    }
  }
}
