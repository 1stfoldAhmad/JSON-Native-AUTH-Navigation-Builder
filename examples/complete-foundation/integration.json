{
  "schemaVersion": "1.0.0",
  "builderVersion": "1.0.0",
  "projectId": "expo-complete-commerce-foundation",
  "moduleId": "integration.commerce",
  "id": "application.integration",
  "authNavigation": {
    "enabled": true,
    "guestEntry": "login",
    "authenticatedEntry": "main-tabs",
    "afterLogin": "restore-intended-destination",
    "afterRegistration": "verify-email",
    "afterLogout": "login",
    "verificationRoute": "verify-email",
    "accessDeniedRoute": "access-denied",
    "sessionExpiredRoute": "login",
    "accountSuspendedRoute": "access-denied",
    "roleRouteGroups": {
      "admin": "admin-dashboard"
    },
    "events": {
      "auth.login.success": {
        "action": "restore-intended-destination",
        "flowRef": "flow.auth.after-login"
      },
      "auth.logout.success": {
        "action": "reset",
        "targetRoute": "login",
        "flowRef": "flow.auth.cleanup-user-cache"
      }
    }
  }
}
