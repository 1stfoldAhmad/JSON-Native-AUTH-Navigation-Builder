{
  "schemaVersion": "1.0.0",
  "builderVersion": "1.0.0",
  "projectId": "expo-complete-commerce-foundation",
  "moduleId": "navigation.commerce",
  "id": "application.navigation",
  "platforms": {
    "ios": {
      "renderer": "expo-ui",
      "strictNative": true,
      "mode": "strict-native"
    },
    "android": {
      "renderer": "auto",
      "fallback": "expo-router",
      "mode": "automatic-fallback"
    }
  },
  "rootNavigator": "root-stack",
  "navigators": [
    {
      "id": "root-stack",
      "type": "stack",
      "initialRoute": "guest-stack",
      "children": [
        "guest-stack",
        "main-tabs",
        "admin-dashboard",
        "access-denied"
      ]
    },
    {
      "id": "guest-stack",
      "type": "stack",
      "initialRoute": "login",
      "children": ["login", "register", "verify-email"]
    },
    {
      "id": "main-tabs",
      "type": "tabs",
      "initialRoute": "home-stack",
      "children": ["home-stack", "search-stack", "profile-stack"],
      "tabsOptions": {
        "initialTab": "home-stack",
        "preserveTabState": true,
        "tabs": [
          { "routeId": "home-stack", "label": "Home", "icon": "house.fill" },
          { "routeId": "search-stack", "label": "Search", "icon": "magnifyingglass" },
          { "routeId": "profile-stack", "label": "Profile", "icon": "person.crop.circle" }
        ]
      }
    },
    {
      "id": "home-stack",
      "type": "stack",
      "initialRoute": "home",
      "children": ["home", "order-detail", "notifications"]
    },
    {
      "id": "search-stack",
      "type": "stack",
      "initialRoute": "search",
      "children": ["search", "product-detail"]
    },
    {
      "id": "profile-stack",
      "type": "stack",
      "initialRoute": "profile",
      "children": ["profile", "settings"]
    }
  ],
  "routes": [
    {
      "id": "login",
      "name": "Sign In",
      "path": "/login",
      "screenRef": "screen.auth.login",
      "navigatorId": "guest-stack",
      "access": "guest",
      "options": { "title": "Sign In", "headerShown": false }
    },
    {
      "id": "register",
      "name": "Create Account",
      "path": "/register",
      "screenRef": "screen.auth.register",
      "navigatorId": "guest-stack",
      "access": "guest",
      "options": { "title": "Create Account" }
    },
    {
      "id": "verify-email",
      "name": "Verify Email",
      "path": "/verify",
      "screenRef": "screen.auth.verify",
      "navigatorId": "guest-stack",
      "access": "public",
      "options": { "title": "Verify Email" }
    },
    {
      "id": "home",
      "name": "Home",
      "path": "/home",
      "screenRef": "screen.app.home",
      "navigatorId": "home-stack",
      "access": "authenticated",
      "options": { "title": "Home", "tabLabel": "Home", "tabIcon": "house.fill" }
    },
    {
      "id": "order-detail",
      "name": "Order Details",
      "path": "/orders/:orderId",
      "screenRef": "screen.app.order-detail",
      "navigatorId": "home-stack",
      "access": {
        "permissions": ["orders.read"],
        "mode": "all"
      },
      "params": {
        "orderId": { "type": "string", "required": true },
        "tab": {
          "type": "enum",
          "required": false,
          "default": "summary",
          "enumValues": ["summary", "items", "shipment", "tracking"]
        }
      },
      "deepLink": {
        "enabled": true,
        "aliases": ["/order/:orderId"],
        "universalLink": true
      },
      "options": { "title": "Order Details" }
    },
    {
      "id": "notifications",
      "name": "Notifications",
      "path": "/notifications",
      "screenRef": "screen.app.notifications",
      "navigatorId": "home-stack",
      "access": "authenticated",
      "options": { "title": "Notifications" }
    },
    {
      "id": "search",
      "name": "Search",
      "path": "/search",
      "screenRef": "screen.app.search",
      "navigatorId": "search-stack",
      "access": "authenticated",
      "options": { "title": "Search", "tabLabel": "Search", "tabIcon": "magnifyingglass" }
    },
    {
      "id": "product-detail",
      "name": "Product Detail",
      "path": "/products/:productId",
      "screenRef": "screen.app.product-detail",
      "navigatorId": "search-stack",
      "access": "public",
      "params": {
        "productId": { "type": "string", "required": true }
      },
      "options": { "title": "Product Detail" }
    },
    {
      "id": "profile",
      "name": "Profile",
      "path": "/profile",
      "screenRef": "screen.app.profile",
      "navigatorId": "profile-stack",
      "access": "authenticated",
      "options": { "title": "Profile", "tabLabel": "Profile", "tabIcon": "person.crop.circle" }
    },
    {
      "id": "settings",
      "name": "Settings",
      "path": "/settings",
      "screenRef": "screen.app.settings",
      "navigatorId": "profile-stack",
      "access": "verified",
      "options": { "title": "Settings" }
    },
    {
      "id": "admin-dashboard",
      "name": "Admin Dashboard",
      "path": "/admin",
      "screenRef": "screen.admin.dashboard",
      "navigatorId": "root-stack",
      "access": {
        "roles": ["admin"],
        "mode": "any"
      },
      "options": { "title": "Admin Dashboard" }
    },
    {
      "id": "access-denied",
      "name": "Access Denied",
      "path": "/access-denied",
      "screenRef": "screen.auth.access-denied",
      "navigatorId": "root-stack",
      "access": "public",
      "options": { "title": "Access Denied" }
    }
  ],
  "linking": {
    "scheme": "efshop",
    "hosts": ["shop.expo-foundation.dev"],
    "universalLinks": true,
    "androidAppLinks": true
  }
}
