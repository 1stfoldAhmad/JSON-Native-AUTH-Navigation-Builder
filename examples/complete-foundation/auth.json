{
  "schemaVersion": "1.0.0",
  "builderVersion": "1.0.0",
  "projectId": "expo-complete-commerce-foundation",
  "moduleId": "auth.commerce",
  "id": "application.auth",
  "enabled": true,
  "provider": {
    "type": "rest",
    "ref": "commerce-rest-api"
  },
  "providers": {
    "commerce-rest-api": {
      "type": "rest",
      "baseUrl": "https://api.shop.expo-foundation.dev/v1",
      "timeoutMs": 10000,
      "retryPolicy": {
        "maxRetries": 2,
        "backoffMs": 150
      }
    }
  },
  "session": {
    "restoreOnLaunch": true,
    "storage": "secure-store",
    "refreshEnabled": true,
    "refreshStrategy": "before-expiration",
    "refreshThresholdSeconds": 60,
    "rotateRefreshTokens": true,
    "revokeOnLogout": true
  },
  "methods": {
    "password": true,
    "registration": true,
    "emailVerification": true,
    "passwordReset": true,
    "otp": true,
    "oauth": true,
    "apple": true,
    "google": true,
    "biometric": true,
    "mfa": true
  },
  "screenRefs": {
    "login": "screen.auth.login",
    "register": "screen.auth.register",
    "verification": "screen.auth.verify",
    "forgotPassword": "screen.auth.forgot-password",
    "resetPassword": "screen.auth.reset-password",
    "mfa": "screen.auth.mfa"
  },
  "events": {
    "onLoginSuccess": "flow.auth.after-login",
    "onLogout": "flow.auth.cleanup-user-cache",
    "onRegisterSuccess": "flow.auth.track-signup"
  },
  "accessControl": {
    "defaultRoles": ["user"],
    "requireEmailVerification": false,
    "supportedRoles": ["user", "admin", "merchant"],
    "supportedPermissions": ["orders.read", "orders.write", "admin.access"]
  }
}
