{
  "expo": {
    "name": "Phase 0 Native Navigation POC",
    "slug": "phase-0-native-navigation-poc",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "scheme": "pocapp",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.expofoundation.nativepoc",
      "associatedDomains": ["applinks:poc.expo-foundation.dev"]
    },
    "android": {
      "package": "dev.expofoundation.nativepoc",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "poc.expo-foundation.dev",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": ["expo-router"]
  }
}
