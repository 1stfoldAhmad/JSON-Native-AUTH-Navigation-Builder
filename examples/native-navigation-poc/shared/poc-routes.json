{
  "schemaVersion": "1.0.0",
  "id": "phase0-native-navigation-poc",
  "platforms": {
    "ios": {
      "renderer": "expo-ui",
      "strictNative": true,
      "mode": "strict-native"
    },
    "android": {
      "renderer": "auto",
      "fallback": "expo-router",
      "mode": "automatic-fallback"
    }
  },
  "rootNavigator": "root-stack",
  "navigators": [
    {
      "id": "root-stack",
      "type": "stack",
      "initialRoute": "guest-stack",
      "children": ["guest-stack", "main-tabs"]
    },
    {
      "id": "guest-stack",
      "type": "stack",
      "initialRoute": "login",
      "children": ["login", "register", "verify"]
    },
    {
      "id": "main-tabs",
      "type": "tabs",
      "initialRoute": "home-stack",
      "children": ["home-stack", "search-stack", "profile-stack"]
    },
    {
      "id": "home-stack",
      "type": "stack",
      "initialRoute": "home",
      "children": ["home", "order-detail"]
    },
    {
      "id": "search-stack",
      "type": "stack",
      "initialRoute": "search",
      "children": ["search", "product-detail"]
    },
    {
      "id": "profile-stack",
      "type": "stack",
      "initialRoute": "profile",
      "children": ["profile", "settings"]
    }
  ],
  "routes": [
    {
      "id": "login",
      "path": "/login",
      "screenRef": "screen.auth.login",
      "navigatorId": "guest-stack",
      "access": "guest"
    },
    {
      "id": "register",
      "path": "/register",
      "screenRef": "screen.auth.register",
      "navigatorId": "guest-stack",
      "access": "guest"
    },
    {
      "id": "verify",
      "path": "/verify",
      "screenRef": "screen.auth.verify",
      "navigatorId": "guest-stack",
      "access": "public"
    },
    {
      "id": "home",
      "path": "/home",
      "screenRef": "screen.app.home",
      "navigatorId": "home-stack",
      "access": "authenticated"
    },
    {
      "id": "order-detail",
      "path": "/orders/:orderId",
      "screenRef": "screen.app.order-detail",
      "navigatorId": "home-stack",
      "access": "authenticated",
      "params": {
        "orderId": { "type": "string", "required": true },
        "tab": { "type": "string", "required": false, "default": "summary" }
      }
    },
    {
      "id": "search",
      "path": "/search",
      "screenRef": "screen.app.search",
      "navigatorId": "search-stack",
      "access": "authenticated"
    },
    {
      "id": "product-detail",
      "path": "/products/:productId",
      "screenRef": "screen.app.product-detail",
      "navigatorId": "search-stack",
      "access": "authenticated",
      "params": {
        "productId": { "type": "string", "required": true }
      }
    },
    {
      "id": "profile",
      "path": "/profile",
      "screenRef": "screen.app.profile",
      "navigatorId": "profile-stack",
      "access": "authenticated"
    },
    {
      "id": "settings",
      "path": "/settings",
      "screenRef": "screen.app.settings",
      "navigatorId": "profile-stack",
      "access": "authenticated"
    }
  ],
  "linking": {
    "scheme": "pocapp",
    "hosts": ["poc.expo-foundation.dev"],
    "universalLinks": true,
    "androidAppLinks": true
  }
}
