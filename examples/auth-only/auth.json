{
  "schemaVersion": "1.0.0",
  "builderVersion": "1.0.0",
  "projectId": "expo-auth-standalone-demo",
  "moduleId": "auth.standalone",
  "id": "application.auth",
  "enabled": true,
  "provider": {
    "type": "rest",
    "ref": "provider.primary",
    "config": {
      "baseUrl": "${env.AUTH_API_URL}",
      "endpoints": {
        "login": { "method": "POST", "path": "/auth/login" },
        "register": { "method": "POST", "path": "/auth/register" },
        "refresh": { "method": "POST", "path": "/auth/refresh" },
        "logout": { "method": "POST", "path": "/auth/logout" },
        "forgotPassword": { "method": "POST", "path": "/auth/forgot-password" },
        "resetPassword": { "method": "POST", "path": "/auth/reset-password" },
        "verifyEmail": { "method": "POST", "path": "/auth/verify-email" }
      },
      "responseMapping": {
        "accessToken": "$.data.access_token",
        "refreshToken": "$.data.refresh_token",
        "user": "$.data.user",
        "expiresIn": "$.data.expires_in"
      }
    }
  },
  "session": {
    "restoreOnLaunch": true,
    "storage": "secure-store",
    "refreshEnabled": true,
    "refreshStrategy": "before-expiration",
    "refreshThresholdSeconds": 60,
    "rotateRefreshTokens": true,
    "revokeOnLogout": true
  },
  "methods": {
    "password": true,
    "registration": true,
    "emailVerification": true,
    "passwordReset": true,
    "otp": false,
    "oauth": false
  },
  "screenRefs": {
    "login": "screen.auth.login",
    "register": "screen.auth.register",
    "verification": "screen.auth.verify"
  },
  "events": {
    "loginSuccess": {
      "event": "auth.login.success",
      "flowRef": "flow.auth.after-login"
    },
    "logoutSuccess": "auth.logout.success"
  }
}
