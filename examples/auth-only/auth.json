{
  "schemaVersion": "1.0.0",
  "builderVersion": "1.0.0",
  "projectId": "expo-auth-standalone-demo",
  "moduleId": "auth.standalone",
  "id": "application.auth",
  "enabled": true,
  "provider": {
    "type": "oidc",
    "ref": "corporate-oidc"
  },
  "providers": {
    "corporate-oidc": {
      "type": "oidc",
      "issuer": "https://idp.example.com",
      "clientId": "expo-mobile-client",
      "redirectUri": "efauth://callback",
      "scopes": ["openid", "profile", "email"]
    }
  },
  "session": {
    "restoreOnLaunch": true,
    "storage": "secure-store",
    "refreshEnabled": true,
    "refreshStrategy": "before-expiration",
    "refreshThresholdSeconds": 60,
    "rotateRefreshTokens": true,
    "revokeOnLogout": true
  },
  "methods": {
    "password": true,
    "registration": true,
    "emailVerification": true,
    "passwordReset": true,
    "otp": true,
    "oauth": true,
    "oidc": true,
    "biometric": true,
    "mfa": true
  },
  "screenRefs": {
    "login": "screen.auth.login",
    "register": "screen.auth.register",
    "verification": "screen.auth.verify",
    "forgotPassword": "screen.auth.forgot-password",
    "resetPassword": "screen.auth.reset-password",
    "mfa": "screen.auth.mfa"
  },
  "events": {
    "onLoginSuccess": "flow.auth.after-login",
    "onLogout": "flow.auth.cleanup-user-cache"
  },
  "accessControl": {
    "defaultRoles": ["user"],
    "requireEmailVerification": false
  }
}
