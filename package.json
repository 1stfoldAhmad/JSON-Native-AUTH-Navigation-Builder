{
  "name": "expo-app-foundation",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable JSON-Driven Expo Auth Builder & Native Navigation Builder (Expo SDK 58)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/core packages/auth packages/navigation packages/integration packages/expo-generator",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:builder": "npm --workspace @expo-foundation/builder run dev",
    "build:builder": "npm --workspace @expo-foundation/builder run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
